# All common settings are editable in the browser at /setup.
# data/settings.json takes precedence over corresponding .env values.
MODE=demo
SHOW_PROFILE=talk
PORT=8787
# HOST=127.0.0.1 # Set to 0.0.0.0 to allow access from Tailscale/LAN
# TAILSCALE_HOST= # with HOST=0.0.0.0: your tailnet name or 100.x address, printed as the phone URL at startup
SESSION_MINUTES=30
# Local judge (safety/quality gate). Unset = LLM_MODEL on LLM_BASE_URL. Needed with LLM_PROVIDER=gemini.
# JUDGE_MODEL=
# JUDGE_BASE_URL=http://127.0.0.1:11434/v1
# JUDGE_TIMEOUT_MS=20000
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=
# Optional bigger model on another machine (e.g. an RTX 5080 Ubuntu box running Ollama on the LAN; src/llm-route.mjs).
# Used for generation and the local judge only while it answers and has the model (checked every minute);
# otherwise LLM_MODEL above goes on. Ubuntu side: OLLAMA_HOST=0.0.0.0, LAN only (never expose it to the internet).
# LLM_REMOTE_URL=http://192.168.1.50:11434/v1
# LLM_REMOTE_MODEL=qwen3.5:14b
# JUDGE_REMOTE_MODEL=
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.06
VOICEVOX_CREDIT=
# Comment narration (always VOICEVOX, separate voice from the host).
# READ_COMMENTS=true
# COMMENT_VOICEVOX_SPEAKER=1
# COMMENT_VOICEVOX_SPEED=1.15
# COMMENT_VOICEVOX_CREDIT=
# MAX_READ_COMMENT_CHARS=120
# MAX_READ_AUDIO_MS=10000
# MAX_TURN_AUDIO_MS=18000
# MAX_REACTION_AUDIO_MS=1200   # reaction sound budget on top of MAX_TURN_AUDIO_MS (absolute ceiling = both)
# Host voice engine: voicevox | supertonic | aivisspeech | sbv2 | gemini-tts | gemini-lite-tts (paid cloud, uses GEMINI_API_KEY). Never falls back to another voice. See docs/VOICE.md.
# REPLY_TTS_PROVIDER=voicevox
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_STYLE=a warm, playful young VTuber, clear diction
# GEMINI_TTS_MAX_USD=3   # spend cap per server run; reaching it holds speech (never another voice)
# SUPERTONIC_URL=http://127.0.0.1:7788
# SUPERTONIC_VOICE=F1
# SUPERTONIC_STEPS=8
# SUPERTONIC_SPEED=1.05
# AivisSpeech Engine (AIVIS_STYLE: a style id from /speakers, 0..2147483647; 0 = not set).
# AIVIS_URL=http://127.0.0.1:10101
# AIVIS_STYLE=0
# AIVIS_SPEED=1
# AIVIS_INTONATION=1
# AIVIS_TEMPO=1
# AIVIS_CREDIT=
# Noa's adopted voice (2026-09-28): AivisSpeech コハク／ノーマル, ACML 1.0 — credit required on screen and in the description:
# REPLY_TTS_PROVIDER=aivisspeech
# AIVIS_STYLE=1878365376
# AIVIS_CREDIT=AivisSpeech：コハク（オズチャット）
# Style-Bert-VITS2 server_fastapi.py (use port 5055: macOS AirPlay holds :5000). Firewall it; never expose it.
# SBV2_URL=http://127.0.0.1:5055
# SBV2_MODEL=
# SBV2_SPEAKER=
# SBV2_STYLE=Neutral
# SBV2_STYLE_WEIGHT=1
# SBV2_SPEED=1
# SBV2_CREDIT=
# Voice family → style JSON, e.g. {"surprise":888753761} (AivisSpeech) or {"joy":"Happy","surprise":"Surprise","worry":"Sad"} (SBV2 JVNV).
# HOST_STYLE_MAP=
# Directed host voice (dark launch): off | reaction | jev. REACTION_AUDIO and PHRASE_CACHE require direction.
# SPEECH_DIRECTION=off
# REACTION_AUDIO=false
# PHRASE_CACHE=false
YOUTUBE_VIDEO_ID=
YOUTUBE_API_KEY=
YOUTUBE_TRANSPORT=stream
# Optional read-only OAuth alternative; run npm run youtube:auth.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
ALLOW_OBS_STREAM=false
TURN_GAP_MS=250
MAX_CHAT_QUEUE=20
MAX_REPLY_QUEUE=2
MAX_LLM_CALLS=600
MAX_TTS_CALLS=600
MAX_YOUTUBE_CALLS=1000
# Idle puzzle moves: rule (shortest path, no API calls, default) | jev (one paid Jev call per move)
# GAME_CONTROLLER=rule
# GEMINI_TTS_MAX_USD_MONTH=10   # monthly cap; spend persists in data/cloud-spend.json
# GEMINI_TTS_STREAM=true        # stream Gemini audio (start on the first chunk)

# Optional local monitoring and output profiles (no stream starts automatically).
# MEMORY_GUARD=1              # macOS pressure checks; see docs/memory-protection.md
# Disk headroom (live mode, on unless DISK_GUARD=0): before a start, player logs older than DISK_RUNS_DAYS, Studio logs and
# round reviews older than DISK_LOGS_DAYS, and OBS recordings (OBS's own date names only) past the newest DISK_KEEP_RECORDINGS
# are removed; the start needs DISK_START_GB free. On air: below DISK_LOW_GB the recording stops, below DISK_CRITICAL_GB the show says goodbye.
# DISK_GUARD=0
# DISK_START_GB=20
# DISK_LOW_GB=8
# DISK_CRITICAL_GB=3
# DISK_KEEP_RECORDINGS=2
# DISK_RUNS_DAYS=7
# DISK_LOGS_DAYS=14
# AUDIENCE_ANALYTICS=1
# GAME_FRAME_PROBE=1          # extra screen capture OFF by default
# STREAM_TARGET=simulcast     # youtube | twitch | simulcast; requires configured OBS profiles
# TWITCH_ENABLED=true
# TWITCH_CHANNEL=your_channel
# YOUTUBE_CHANNEL_ID=
# KEEP_LIVE=1                 # stay on air through transient trouble: provider failures and refused lines hold instead of
#                             # stopping the show, and a lasting memory warning no longer stops it (hard limits still do)
# CLOSING_SECONDS=120         # goodbye over ~2 min (recap, thanks, replies to goodbye comments) instead of one line; a normal
#                             # stop says it first (press stop again to cut it short). 0 = the single closing line
# WIND_DOWN_MINUTES=10        # within this long of the end, the goodbye starts when a game round ends (natural break);
#                             # otherwise at CLOSING_SECONDS + 30 s before the end
# CLOSING_NOTICE=             # optional line about the next stream, spoken in the goodbye (e.g. 次は日曜の夜に配信するよ。)
# A new stream title on YouTube and Twitch for every broadcast, numbered in data/stream-title.json (0 = off).
# Twitch needs its own permission once: node scripts/twitch-auth.mjs start --title, then complete --title.
# STREAM_TITLE=1
# Show format (operator 2026-10-11): 配信準備中 STANDBY_SECONDS → opening talk (programme lobbyMinutes) → game →
# goodbye (CLOSING_SECONDS; a game show ends the game on the game screen, then recaps on the talk screen) → end screen.
# STANDBY_SECONDS=60   # 0 = off. One gated audio-check line plays before OBS starts; the show holds until the programme scene is on air.
# CLOSING_SECONDS=180
# END_SCREEN_SECONDS=60
# Clip studio (npm run clips): after a completed live show with OBS_RECORD=true, edited clips, Shorts and thumbnails
# are made from the recording and published. Needs ffmpeg with libass/freetype (brew install ffmpeg-full).
# CLIP_AUTO=1            # 0 = no automatic run after a show
# CLIP_PRIVACY=public    # public | unlisted | private
# CLIP_DAILY_UNITS=6500  # YouTube API units a day for uploads (1600 a video, 50 a thumbnail; the project has 10,000)
# CLIP_FFMPEG=           # default: /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg when present
