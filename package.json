{
  "name": "jev-vtuber-studio",
  "version": "0.2.0-rc.6",
  "private": true,
  "description": "Autonomous talk VTuber: VOICEVOX comment narrator, parallel LLM replies, optional Supertonic 3 host, private mobile remote.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/supervised.mjs",
    "setup:avatar": "npm install --no-save --package-lock=false --ignore-scripts three@0.186.1 @pixiv/three-vrm@3.5.5 @pixiv/three-vrm-animation@3.5.5 esbuild@0.28.2",
    "build:avatar": "node scripts/build-vrm-avatar.mjs",
    "check:avatar": "node scripts/build-vrm-avatar.mjs --check",
    "evaluate:avatar": "node scripts/build-vrm-avatar.mjs --evaluate",
    "evaluate:outfits": "node scripts/build-vrm-avatar.mjs --evaluate-outfits",
    "demo": "node src/server.mjs --demo",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "switch:check": "node scripts/switch-check.mjs",
    "youtube:auth": "node scripts/youtube-auth.mjs",
    "youtube:schedule": "node scripts/youtube-schedule.mjs",
    "clips": "node scripts/clip-studio.mjs",
    "post-stream": "node scripts/post-stream.mjs",
    "supervised": "node scripts/supervised.mjs",
    "setup:youtube": "npm install --no-save --package-lock=false --ignore-scripts @grpc/grpc-js@1.14.0 @grpc/proto-loader@0.8.0",
    "benchmark": "node scripts/benchmark.mjs",
    "release:check": "npm run check && npm test",
    "pack:release": "node scripts/package-release.mjs",
    "test:regression": "node --test test/rc2-regression.test.mjs",
    "test:package": "node --test test/release.test.mjs",
    "remote:setup": "node scripts/remote-setup.mjs",
    "test:remote": "node --test test/remote.test.mjs test/remote-flow.test.mjs",
    "test:comment-reply": "node --test test/comment*.test.mjs",
    "test:programme": "node --test test/programme*.test.mjs",
    "episode:brief": "node scripts/episode-brief.mjs",
    "log:analyze": "node scripts/analyze-log.mjs",
    "test:voice": "node --test test/voice*.test.mjs",
    "voice:library": "node scripts/voice-library.mjs",
    "voice:bench": "node scripts/voice-benchmark.mjs",
    "voice:design": "node scripts/voice-design.mjs",
    "analytics": "node scripts/audience-analytics.mjs",
    "performance": "node scripts/stream-performance.mjs",
    "hotkeys": "node scripts/global-hotkeys.mjs"
  },
  "license": "MIT",
  "bin": {
    "jev-studio": "scripts/cli.mjs"
  },
  "files": [
    "src/",
    "browser/",
    "public/",
    "config/",
    "games/",
    "proto/",
    "scripts/*.mjs",
    "scripts/*.py",
    "scripts/*.swift",
    "test/",
    ".github/",
    ".env.example",
    "start.sh",
    "start.cmd",
    "start.command",
    "docs/*.md",
    "docs/vrm-motion-evaluation.json",
    "docs/vrm-outfit-evaluation.json",
    "docs/*preview.png",
    "docs/setup-mobile.png",
    "docs/browser-check.json",
    "docs/test-results.tap",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    ".gitignore",
    ".npmignore",
    "docs/rc2-*.json",
    "docs/remote-test-results.tap",
    "docs/remote-browser-check.json",
    "docs/comment-test-results.tap",
    "docs/rc4-*.json",
    "docs/programme-*.json"
  ]
}
